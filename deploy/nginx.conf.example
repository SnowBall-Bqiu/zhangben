# Host Nginx TLS termination example, included inside nginx's http {} context.
# Replace EVERY ledger.example.com and both certificate paths before use.
# This example assumes Nginx itself receives public HTTPS traffic directly.
# If a CDN/load balancer is in front, configure and restrict its trusted IPs first;
# never copy arbitrary incoming X-Forwarded-* headers to the application.

server {
    listen 80;
    listen [::]:80;
    server_name ledger.example.com;
    server_tokens off;

    # Use the configured hostname rather than reflecting the incoming Host header.
    return 308 https://ledger.example.com$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ledger.example.com;
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/ledger.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ledger.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:zhangben_tls:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Only accept this deployment's public hostname.
    if ($host != ledger.example.com) { return 444; }

    client_max_body_size 100k;
    client_header_timeout 10s;
    client_body_timeout 10s;
    keepalive_timeout 30s;
    send_timeout 30s;

    # No includeSubDomains/preload: other services under this domain may differ.
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        # Keep in sync with the HOST-side PORT value in .env.
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_set_header Host ledger.example.com;
        proxy_set_header X-Forwarded-Host ledger.example.com;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Real-IP $remote_addr;
        # Overwrite, rather than append to, client-supplied forwarding headers.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";

        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        proxy_request_buffering on;
        proxy_cache off;

        # Nginx supplies the single HSTS header, including its own error responses.
        proxy_hide_header Strict-Transport-Security;
    }
}
