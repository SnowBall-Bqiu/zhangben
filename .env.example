# Server
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
DATA_DIR=/app/data

# Set to true only when the site is served over HTTPS.
SESSION_COOKIE_SECURE=true

# Required in production. Generate 32+ random bytes before deployment; never use an example value.
SESSION_SECRET=

# Required in production: the exact public HTTPS origin (no path).
PUBLIC_ORIGIN=https://ledger.example.com

# Required in production: comma-separated actual reverse proxy IPs/CIDRs.
# For Docker, use the proxy source address seen inside the container, not blindly loopback.
TRUSTED_PROXIES=

# Optional: initial admin password (15+ characters, at most 72 UTF-8 bytes).
# If empty, a random temporary password is printed once when initializing an empty database.
INITIAL_ADMIN_PASSWORD=
